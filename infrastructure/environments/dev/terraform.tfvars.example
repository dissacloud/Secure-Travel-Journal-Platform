aws_region   = "eu-west-2"
environment  = "dev"
project_name = "secure-travel-journal"

vpc_cidr = "10.40.0.0/16"

availability_zones = [
  "eu-west-2a",
  "eu-west-2b"
]

public_subnet_cidrs = [
  "10.40.0.0/24",
  "10.40.1.0/24"
]

private_subnet_cidrs = [
  "10.40.16.0/20",
  "10.40.32.0/20"
]

database_subnet_cidrs = [
  "10.40.2.0/24",
  "10.40.3.0/24"
]

flow_log_retention_days = 365

# EKS
eks_cluster_version = "1.36"

eks_service_ipv4_cidr = "172.20.0.0/16"

# Secure default is false.
# Enable temporarily for workstation administration if required.
eks_endpoint_public_access = false

eks_public_access_cidrs = []

eks_admin_principal_arn = "arn:aws:iam::905418272482:role/aws-reserved/sso.amazonaws.com/eu-west-2/AWSReservedSSO_AWSAdministratorAccess_5fa7f39beba48869"

eks_deletion_protection = true